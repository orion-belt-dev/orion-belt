# Build stage: runs on the build machine and cross-compiles for the target
# platform, so multi-arch builds need no emulation for Go.
FROM --platform=$BUILDPLATFORM golang:1.27.3-alpine@sha256:d530cf60723abf1ffae0cd16bb546b379ec0550d2f3815e5b16ed69dbc00fba4 AS builder

RUN apk add --no-cache git make

WORKDIR /build

COPY go.mod go.sum ./
RUN go mod download

COPY . .
# Version comes in as build args; see docker/Dockerfile.
ARG TARGETOS TARGETARCH TARGETVARIANT VERSION COMMIT DATE
RUN CGO_ENABLED=0 GOOS=$TARGETOS GOARCH=$TARGETARCH GOARM=${TARGETVARIANT#v} make build-agent \
    ${VERSION:+VERSION=$VERSION} ${COMMIT:+COMMIT=$COMMIT} ${DATE:+DATE=$DATE}

# Agent image
FROM alpine:3.24@sha256:71e9b7bae160ba167fa17414401b94cbcdaf3c32feeab9298bd794a2a0614c35 AS agent

# The agent dials out to the server over a reverse SSH tunnel and manages the
# host it runs on directly (setuid-drop to the requested local user) — it does
# not run its own sshd, so no ssh server, no local user accounts, no password
# auth. It only needs to reach the server outbound.
# scp (openssh-client-common) is the receiving end of ocp copies: the agent
# runs "scp -t <path>" for an upload and "scp -f <path>" for a download.
RUN apk add --no-cache ca-certificates openssh-client-common

WORKDIR /app

COPY --from=builder /build/bin/orion-belt-agent /app/
COPY docker/agent-entrypoint.sh /app/entrypoint.sh
RUN chmod +x /app/entrypoint.sh

RUN mkdir -p /etc/orion-belt

ENTRYPOINT ["/app/entrypoint.sh"]
