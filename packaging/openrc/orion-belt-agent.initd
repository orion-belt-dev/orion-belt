#!/sbin/openrc-run
# Orion Belt agent (OpenRC)

name="orion-belt-agent"
description="Orion Belt reverse-SSH agent"
command="/usr/bin/orion-belt-agent"
command_args="-c /etc/orion-belt/agent.yaml"
# supervise-daemon restarts it if it exits (e.g. the gateway or database is
# unreachable at boot), as systemd's Restart= does.
supervisor="supervise-daemon"
respawn_delay=5
respawn_max=0
output_log="${output_log:-/var/log/orion-belt-agent.log}"
error_log="${error_log:-/var/log/orion-belt-agent.log}"

depend() {
	need net
	use dns logger
	after firewall
}

start_pre() {
	checkpath -d -m 0750 /etc/orion-belt
}
