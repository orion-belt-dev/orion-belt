# syntax=docker/dockerfile:1
ARG BASE=ubuntu:24.04@sha256:2198e4c65076e9cb0b3d695219df667c0e3b0072da64ca3c2648aca17dcecaf5
FROM golang:1.27.4-bookworm@sha256:4fa7c968ba93f1635670522dbb01a2c78150443e1385746924566079f36570ea AS builder
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -o /out/orion-belt-agent ./cmd/agent

FROM ${BASE}
COPY --from=builder /out/orion-belt-agent /usr/bin/orion-belt-agent
COPY lab/compose/agent-entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh /usr/bin/orion-belt-agent
ENTRYPOINT ["/entrypoint.sh"]
